{
  "productName": "MouseVPN",
  "version": "0.2.3",
  "identifier": "dev.mousevpn.linux",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MouseVPN",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Fast private MouseVPN client",
    "longDescription": "MouseVPN desktop client for Linux",
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "depends": [
          "iproute2",
          "nftables",
          "policykit-1"
        ],
        "recommends": ["systemd-resolved"]
      }
    }
  }
}
